# Database Passwords -- every one distinct. Generate them all (and the other
# secrets below) with: python3 scripts/generate_secrets.py
# Each MySQL container resets its accounts to these on every start
# (scripts/mysql_credentials_entrypoint.sh): root logs in from inside the
# container only (root@localhost, no root@'%'), so a changed value here takes
# effect at the next `docker compose up`.
#
# Production database: MYSQL_PASSWORD is production_user's, used only by
# production_eshop and the jobs that read production (seed, sync, backup).
MYSQL_ROOT_PASSWORD=change_this_root_password_in_production
MYSQL_PASSWORD=change_this_user_password_in_production

# Honeypot pool databases 1-3 (default layer): each pool's own user and root
# password -- MUST differ from each other and from production's. Attackers
# own a pool's WordPress (and so its DB password); the pools share one
# network, so a shared password would open the other pools' databases (and a
# copy of production's would open production). Runtime pools get random ones
# from pool_manager. See ids/testing/test_pool_isolation.sh.
MYSQL_PASSWORD_POOL_1=change_this_pool_1_password
MYSQL_PASSWORD_POOL_2=change_this_user_password_in_production_pool2
MYSQL_PASSWORD_POOL_3=change_this_user_password_in_production_pool3
MYSQL_ROOT_PASSWORD_POOL_1=change_this_pool_1_root_password
MYSQL_ROOT_PASSWORD_POOL_2=change_this_pool_2_root_password
MYSQL_ROOT_PASSWORD_POOL_3=change_this_pool_3_root_password

# db-proxy layer: the honeypot database(s) production_eshop's db.php diverts
# to. One user password for all of them (db.php has one), never production's.
HONEYPOT_DB_PASSWORD=change_this_honeypot_db_password
HONEYPOT_MYSQL_ROOT_PASSWORD=change_this_honeypot_mysql_root_password

# Redis Password
# Used by Redis session store and all services connecting to it
REDIS_PASSWORD=change_this_redis_password_in_production

# WordPress auth keys and salts (production_eshop). They sign login cookies
# and nonces, so they must be secret: wp-config.php is in git and has no
# defaults. Generate each with e.g. `openssl rand -base64 48` (or the
# dashboard's Generate button). Left empty, WordPress makes random ones and
# stores them in the database; honeypot clones scrub them. Changing them logs
# every user out.
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# Honeypot Content Replication
# How often (seconds) honeypot_content_sync mirrors production's pages/posts/
# products into each honeypot pool database, so pools don't go stale after
# their one-time initial seed. See scripts/replicate_content_to_honeypot.sh.
REPLICATION_INTERVAL_SECONDS=300

# Honeypot pool manager (pool_manager service). Every user session gets its
# own pool: a honeypot_eshop_N container plus its own honeypot_database_N,
# seeded from production. The pools scale with the number of user sessions:
# one more pool is built for every session that finds none free (it borrows an
# existing pool until its own is ready, then moves there), and POOL_SPARES
# unowned pools are kept ready on top. POOL_MAX caps the total number of pools.
POOL_SPARES=1
POOL_MAX=10
# Resource limit for scaling: the memory and CPUs all pools together may
# reserve (by their container limits; pools 1-3 from docker-compose.yml count
# too). A WordPress pool reserves 1536 MB / 1.5 CPUs, a database-layer pool
# 512 MB / 0.5 CPUs. Once the next pool would not fit, no more are built and
# every further user session is assigned to the existing pools round-robin.
# 0 = no budget (only POOL_MAX and the host checks below apply).
POOL_MAX_MEMORY_MB=12288
POOL_MAX_CPUS=12
# Pools built at the same time while sessions wait for one.
POOL_PARALLEL_BUILDS=2
# What the budget above charges per pool. Empty = the containers' limits
# (1536 MB / 1.5 CPUs per WordPress pool), the most a pool can ever take. Real
# use is much lower: the pool test measured ~430 MB per pool with near-idle
# CPU, so with limits-based charging scaling stopped at 8 pools while only
# ~3.4 GB were in use. Lower these toward measured use to fit more pools; the
# host checks (POOL_MIN_FREE_MEM_MB, load, disk) still stop growth if the
# host really runs short.
#POOL_RESERVE_MEM_MB=768
#POOL_RESERVE_CPUS=0.75
# A waiting session (one that borrowed a pool while its own is being built)
# only gets the next pool, and only counts as demand for a build, while its
# client has sent a request within this many seconds. A client that cleared
# its cookies leaves its old session behind in the queue; this keeps a new
# pool from going to that abandoned session.
POOL_WAITING_ACTIVE_SECONDS=60
# Fast clone (experimental, off by default). A runtime pool is built by
# cloning the already-configured production database, so its WordPress
# storefront settings (permalinks, shipping, enabled payment gateways) are
# already in place. With this on, the per-pool build skips re-applying them
# via wp-cli -- the slowest part of a build (~50s of the ~140s). Content is
# still mirrored from production by the content-sync step either way. Enable
# only after confirming a built pool serves the shop correctly on your host;
# pools 1-3 from docker-compose.yml are never affected. To cut the pre-build
# of several delayed windows further, also raise POOL_PARALLEL_BUILDS so they
# build in one wave rather than two.
POOL_FAST_CLONE=0
# Scale down: when no request has reached a pool for this many seconds, its
# users' assignments are dropped (a returning user is assigned afresh)
# and pools above POOL_SPARES are removed, freeing their memory/CPU/disk. Pools
# 1-3 from docker-compose.yml are only freed, never removed. 0 = never scale
# down; values below 600 are raised to 600 (nginx caches a session's pool for
# 300 s). The dashboard's pool test forces a scale-down of its own sessions at
# the end of its report instead of waiting for this.
POOL_IDLE_TIMEOUT_SECONDS=1800
# Pools are only built while the host has room. Below these limits no new pool is
# started and the router reuses the existing pools round-robin instead.
# POOL_MIN_FREE_MEM_MB defaults to 2560 (WordPress layer) / 1024 (database layer).
#POOL_MIN_FREE_MEM_MB=2560
POOL_MAX_LOAD_PER_CPU=1.5
POOL_MIN_FREE_DISK_GB=5
# 1 = when a user's assignment expires, destroy their pool and build a clean
# one (if the host has room); 0 = hand the used pool to the next user as it is.
POOL_RECYCLE_IDLE=1

# Main WordPress admin account. The *_db_seed services create it on first
# install and re-apply it on every `docker compose up`, so changing a value
# here and re-running the seeds updates every instance (scripts/
# seed_wordpress_db.sh, ensure_admin_account). The dashboard's WordPress
# Studio page signs in with WP_ADMIN_USER / WP_ADMIN_PASSWORD automatically.
#
# Honeypot instances (pools 1-3 and every pool_manager pool) get the same
# user name and e-mail, so the decoys look identical, but a DIFFERENT
# password: HONEYPOT_WP_ADMIN_PASSWORD. On purpose -- a credential an
# attacker recovers from a decoy (cracked hash, keylogged session, leaked
# wp-config) must not open production. Never set the two to the same value.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_this_wp_admin_password
WP_ADMIN_EMAIL=admin@example.com
HONEYPOT_WP_ADMIN_PASSWORD=change_this_honeypot_wp_admin_password
# Must match whatever hostname/port reverse_proxy is actually reached at
# (nginx.conf's server_name is "localhost *.localhost") -- WordPress bakes
# this into generated links/redirects, so a mismatch here breaks navigation.
WP_SITE_URL=http://localhost
WP_SITE_TITLE=Fernhill Coffee Roasters
# Trusted payment/OAuth callback domains. A WooCommerce shop legitimately puts
# absolute http(s):// URLs in its request URIs (gateway return/notify callbacks,
# OAuth redirect URIs); the edge allows those only to a curated set of bank /
# payment-gateway providers (Slovak, Czech and European -- see the baked-in list
# in reverse_proxy_enhanced/lua/pattern_rules.lua TRUSTED_CALLBACK_DOMAINS) PLUS
# the shop's own host, which is auto-derived from WP_SITE_URL above (no need to
# repeat it here). An absolute URL to any other host is blocked OUTRIGHT with a
# 403 at the edge (never scored or routed to a honeypot, so a callback link
# planted and sent to an innocent visitor cannot divert or mislabel them). Set this
# only to add EXTRA trusted domains your shop calls back to, comma-separated, no
# scheme, e.g. TRUSTED_CALLBACK_DOMAINS=mygateway.example,partner-bank.sk
TRUSTED_CALLBACK_DOMAINS=

# Production outbound internet egress (container_firewall "production" profile).
# Default-deny: a compromised production plugin must not be able to phone home,
# pull a payload or exfiltrate -- which is also what keeps a production
# vulnerability from ever becoming a honeypot-bypass pivot. Manage both of
# these live from the dashboard's WordPress Studio page (it writes them back
# here, so they persist across restarts and a `down -v`).
#   PRODUCTION_INTERNET_EGRESS: TEMPORARY all-internet HTTPS (443) bypass --
#     turn on only while installing/updating a plugin or theme, then off.
#   PRODUCTION_TRUSTED_EGRESS_DOMAINS: persistent allow-list of specific
#     outbound-443 hosts (comma-separated, no scheme), e.g.
#     PRODUCTION_TRUSTED_EGRESS_DOMAINS=downloads.wordpress.org,api.wordpress.org
PRODUCTION_INTERNET_EGRESS=false
PRODUCTION_TRUSTED_EGRESS_DOMAINS=

# Set to 1 to wipe and rebuild the storefront from scratch on the next
# `docker compose up` instead of the normal idempotent no-op -- e.g. to
# restore a clean demo state after running patterns against it. Also
# available as a one-click "Reset demo store" action on the dashboard's
# Backups page, or via scripts/manage_backups.sh, without needing to edit
# this file.
FORCE_RESEED=0
# Optional: Stripe SANDBOX keys (Stripe dashboard -> Developers -> API keys
# with "Test mode" on; pk_test_... / sk_test_...). When both are set, every
# WordPress instance gets the Stripe gateway in test mode -- card
# 4242 4242 4242 4242, any future expiry, any CVC completes an order.
# Leave empty and checkout still works via WooCommerce's built-in offline
# gateways (cash on delivery / direct bank transfer), which the seed always
# enables. Never put live (pk_live_/sk_live_) keys here.
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=

# Session Manager Configuration
# Used by Node.js session management API
SESSION_MANAGER_SECRET=change_this_session_secret_in_production

# ELK SIEM Integration (Elasticsearch, Vector, Kibana)
# Set ELK_ENABLED=true to enable log shipping to external SIEM on separate VM
ELK_ENABLED=false

# Vector Configuration (Primary - logs sent here first)
# This should point to your SIEM VM running the ELK stack's Vector aggregator
VECTOR_HOST=your-siem-vm.example.com
VECTOR_PORT=6000

# Elasticsearch Configuration (Direct access - optional, for monitoring)
ELASTICSEARCH_HOST=your-siem-vm.example.com
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_PROTOCOL=https
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=change_this_elasticsearch_password
ELASTICSEARCH_SSL_ENABLED=true
ELASTICSEARCH_SSL_VERIFY=certificate

# Kibana Configuration (for dashboard access and viewing logs)
KIBANA_HOST=your-siem-vm.example.com
KIBANA_PORT=5601
KIBANA_PROTOCOL=https
KIBANA_SSL_ENABLED=true
KIBANA_SSL_VERIFY=certificate

# Suricata IDS log cleanup
# When the ids stack starts, the Suricata container clears its own logs from
# the previous run (eve.json, fast.log, stats.log, suricata.log, plus any
# rotated files and pcaps in /var/log/suricata) so each run starts clean and
# the dashboard's Network IDS "recent alerts" stay actually recent. On by
# default; set to false to keep Suricata's logs accumulating across runs.
SURICATA_AUTO_CLEANUP=true

# AbuseIPDB Integration
# Used by the threat-intel bulk feed (init_worker.lua), on-demand IP reputation
# checks (pattern_analyzer.lua check_ip_reputation), and confirmed-abuse
# report-back. Get a free-tier key at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=change_this_abuseipdb_api_key
# Minimum confidence score (0-100) for an IP to be pulled into the bulk blacklist feed
ABUSEIPDB_CONFIDENCE_MINIMUM=90
# Free tier daily cap for on-demand /check calls; used to gate the quota counter
ABUSEIPDB_DAILY_CHECK_LIMIT=1000
# The bulk /blacklist pull is OFF by default -- it's the single biggest quota
# consumer of the three AbuseIPDB integrations, and some free-tier accounts
# have a real daily cap as low as single digits. On-demand check/report-back
# stay available either way. Set to true to opt in.
ABUSEIPDB_BLACKLIST_ENABLED=false
# Minimum hours between /blacklist API calls (Redis-backed cache -- restarting
# reverse_proxy does NOT force a fresh call by itself). Default 24h keeps this
# to at most 1 call/day even under frequent restarts.
ABUSEIPDB_BLACKLIST_REFRESH_HOURS=24

# Shared secret that gates the X-Route-Target / X-Risk-Score response
# headers (nginx.conf). These headers exist purely so testing/scenario_*.sh
# can externally verify routing decisions -- without this secret they would
# leak the routing/risk-score oracle to every real client. Set this to a
# random value and pass the same value as INTERNAL_TEST_SECRET in the shell
# environment when running testing/scenario_*.sh (they send it as the
# X-Internal-Test-Auth request header). Leave blank to disable the headers
# entirely.
INTERNAL_TEST_SECRET=change_this_internal_test_secret

# Users are identified by their session, not their IP. The reverse proxy's
# SERVERID cookie is "<session id>.<HMAC>" signed with this key, so a client
# can't edit or forge it. Set a long random value (e.g. `openssl rand -hex 32`)
# so cookies survive proxy restarts and an edited cookie is scored as
# tampering. Blank = a random key per proxy start.
SESSION_SIGNING_KEY=
# A client that clears its cookies is matched back to its session by a passive
# fingerprint (TLS handshake, User-Agent, Accept-Language/-Encoding). By default
# the client IP is part of that fingerprint; false drops it, which also merges
# unrelated visitors that use the same browser build into one session.
SESSION_RECOVERY_USES_IP=true
# Seconds after a session's last request during which that recovery works.
# Kept short so a visitor behind the same carrier-grade NAT with an identical
# browser isn't merged into a user's session long after it went quiet.
SESSION_RECOVERY_WINDOW=900

# Shared addresses (carrier-grade NAT, offices). A client's own behaviour is
# scored on its session; the address's reputation (Suricata alerts, AbuseIPDB)
# adds at most IP_REPUTATION_CAP per request, and nothing once
# SHARED_IP_SESSIONS distinct sessions were active on it within
# SHARED_IP_WINDOW seconds. The default cap (10) can never divert anyone on
# its own; above 50 bad-reputation addresses are diverted again when unshared.
IP_REPUTATION_CAP=10
SHARED_IP_SESSIONS=2
SHARED_IP_WINDOW=3600

# ---------------------------------------------------------------------------
# Threat decay
# ---------------------------------------------------------------------------
# THREAT_DECAY_ENABLED: whether a session's / IP's risk score fades over time
# once no new suspicious signal arrives. Set to false to TURN THREAT DECAY OFF
# entirely -- a score, once earned, then persists indefinitely (until it is
# reset). Applies to both the per-session and the IP-reputation decay paths.
THREAT_DECAY_ENABLED=true
# SCORE_DECAY_HALF_LIFE_SECONDS: when decay is enabled, how long a score takes
# to fall to half its value with no new signal (larger = slower fade). Ignored
# when THREAT_DECAY_ENABLED=false. Default 300.
SCORE_DECAY_HALF_LIFE_SECONDS=300

# ---------------------------------------------------------------------------
# Consent-gated gdpr_signature identity (runs ALONGSIDE the session cookie)
# ---------------------------------------------------------------------------
# A second identifier the reverse proxy can use to re-recognise a visitor even
# after they clear BOTH their cookies and localStorage -- but only with their
# explicit, revocable consent. The browser (reverse_proxy_enhanced/gdpr_client.js,
# injected into every page) shows a consent banner; ONLY if the visitor agrees,
# it RSA-OAEP-encrypts a tiny payload (for this demo: just the screen size) plus
# a timestamp with the server's PUBLIC key into a "gdpr_token" cookie. The proxy
# decrypts it in memory only long enough to check the timestamp and hash the rest
# into a ONE-WAY "gdpr_signature"; only that hash is ever stored (in Redis, with a
# TTL), never anything identifiable. See lua/gdpr_handler.lua and ids/GDPR.md.
#
# GDPR_ENABLED: set to false to disable the whole subsystem (the client script
# becomes inert, no tokens are processed). Default true.
GDPR_ENABLED=true
# GDPR_PRIVATE_KEY: the RSA private key as base64-encoded DER (PKCS#8), on ONE
# line. This is the only secret -- the public key the browser encrypts with is
# derived from it at start-up, and the private key NEVER reaches the client.
# Blank = the GDPR subsystem disables itself. scripts/generate_secrets.py
# generates one, or by hand (flattened to one line):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     -outform DER | base64 -w0
GDPR_PRIVATE_KEY=
# GDPR_TIMESTAMP_WINDOW: how many seconds from "now" a token's embedded
# timestamp may be (replay window). The client re-stamps well inside this.
GDPR_TIMESTAMP_WINDOW=300
# GDPR_BINDING_TTL: how long a honeypot<->signature binding lives in Redis. It
# is prolonged on every match, so an active returning visitor never ages out.
GDPR_BINDING_TTL=3600

# Docker Compose Project Name (for log filtering)
# Vector will only collect logs from containers with this project name
COMPOSE_PROJECT_NAME=honeypot-ids-system-v1

# Environment (development, staging, production)
ENVIRONMENT=production

# Notes:
# - Generate strong random passwords for production deployment
# - Use different passwords for each service
# - Never commit the actual .env file to version control
# - Recommended: Use `openssl rand -base64 32` to generate secure passwords
#
# ELK SIEM Setup (Two-VM Architecture):
# 1. Set ELK_ENABLED=true to enable log shipping via Vector → Vector aggregator
# 2. Configure VECTOR_HOST to point to your SIEM VM IP address
# 3. Copy SSL certificates from SIEM VM to vector/certs/ directory:
#    - ca.crt (CA certificate)
#    - vector-agent.crt (client certificate)
#    - vector-agent.key (client private key)
# 4. Restart vector_outbound: docker compose restart vector_outbound
# 5. Logs will be shipped to the Vector aggregator and stored in Elasticsearch indices:
#    - honeypot-docker-logs-YYYY.MM.DD (Docker container logs)
#    - honeypot-nginx-logs-YYYY.MM.DD (Nginx access/error/security logs)
#    - honeypot-redis-logs-YYYY.MM.DD (Redis logs)
#    - honeypot-generic-logs-YYYY.MM.DD (Suricata IDS logs)
# 6. View and analyze logs in Kibana at https://your-siem-vm:5601
#
# For detailed setup instructions, see: siem/SETUP_GUIDE.md
