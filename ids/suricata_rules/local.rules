###################################################
# Suricata Rules for WordPress Vulnerability Detection
# and Honeypot Traffic Analysis
#
# SOURCE DIRECTION: every rule below matches `any any -> $HOME_NET
# $HTTP_PORTS` rather than the more conventional `$EXTERNAL_NET any ->
# $HOME_NET $HTTP_PORTS`. This was a deliberate fix, not a relaxation for
# convenience: this stack's only realistic local test path is
# curl-over-loopback against the published port (the `arch` VM referenced
# elsewhere in this repo's history is confirmed gone), and a loopback
# connection has an IDENTICAL source and destination address (127.0.0.1).
# Once HOME_NET was widened to include 127.0.0.0/8 (see suricata.yaml) so
# that traffic actually reaching this destination would match at all, that
# same widening reclassified the loopback SOURCE as HOME_NET too --
# EXTERNAL_NET is defined as `!$HOME_NET`, so a source that's now inside
# HOME_NET can never simultaneously satisfy "must be EXTERNAL_NET",
# permanently defeating every rule regardless of payload content. Matching
# on destination alone (any source, as long as it's hitting our protected
# $HOME_NET on an HTTP port) is standard practice for asset-centric
# detection and remains correct for a genuine external adversary too -- it
# just also correctly covers the only test method actually available here.
# Confirmed live: rules did not fire with the original $EXTERNAL_NET
# direction even though capture, rule-loading, and full URI/payload
# visibility were all independently confirmed working first.
#
# PURPOSE:
#   Detect and alert on attack patterns targeting the WooCommerce honeypot.
#   Rules are organised by CVE / attack category and annotated with the
#   corresponding OWASP Web Security Testing Guide (WSTG) v4.2 category so
#   that captured alerts can be directly mapped to the thesis test scenarios.
#
# OWASP WSTG CATEGORY INDEX:
#   WSTG-INFO  – Information Gathering          (sids 1000017-1000020, 1000049)
#   WSTG-CONF  – Configuration Management       (sids 1000019-1000020)
#   WSTG-IDNT  – Identity Management            (sids 1000018)
#   WSTG-ATHN  – Authentication Testing         (sids 1000017)
#   WSTG-AUTHZ – Authorization / Access Control (sids 1000001-1000008)
#   WSTG-INPV  – Input Validation (all sub-cats)(sids 1000011-1000016, 1000026-1000041)
#     WSTG-INPV-01 Directory Traversal           (sids 1000036-1000038)
#     WSTG-INPV-02 XSS                           (sids 1000030-1000032)
#     WSTG-INPV-05 SQL Injection                 (sids 1000011-1000013, 1000026-1000029)
#     WSTG-INPV-10 File Upload                   (sids 1000005-1000006, 1000009-1000010, 1000014-1000016)
#     WSTG-INPV-11 Local/Remote File Inclusion   (sids 1000039-1000041)
#     WSTG-INPV-12 Command Injection             (sids 1000033-1000035)
#   WSTG-SESS  – Session Management             (sids 1000017: brute-force implies session steal)
#
# CVE COVERAGE:
#   CVE-2023-28121  WooCommerce Payments unauth admin     sids 1000001-1000002
#   CVE-2023-2986   Abandoned Cart hardcoded key          sids 1000003-1000004
#   CVE-2025-4403   DnD file upload type bypass           sids 1000005-1000006
#   CVE-2025-2266   CWMP unauthenticated options update   sids 1000007-1000008
#   CVE-2025-47577  Gift Voucher file upload RCE          sids 1000009-1000010
#   CVE-2024-8425   Gift Voucher alternate vector         sid  1000010
#   CVE-2024-2387   AFI SQL injection                     sids 1000011-1000013
#   CVE-2025-10142  PagSeguro path traversal              sids 1000014-1000015
#   CVE-2024-50508  WP File Upload path traversal         sids 1000015-1000016
#
# SID ALLOCATION:
#   1000001-1000016  CVE-specific detection rules
#   1000017-1000025  General WordPress attack patterns + plugin detection
#   1000026-1000029  SQL injection generic patterns (WSTG-INPV-05)
#   1000030-1000032  XSS patterns                  (WSTG-INPV-02)
#   1000033-1000035  Command injection             (WSTG-INPV-12)
#   1000036-1000038  Directory traversal           (WSTG-INPV-01)
#   1000039-1000041  File inclusion wrappers       (WSTG-INPV-11)
#   1000042-1000048  Malicious user-agent strings  (WSTG-INFO-02)
#   1000049          Version fingerprinting probe  (WSTG-INFO-02)
#
# NOTES:
#   - All rules use classtype:web-application-attack unless otherwise noted.
#   - Rules are intentionally kept BROAD to maximise honeypot capture rate;
#     false-positive rate on the production instance is managed by the Nginx Lua
#     routing layer (router.lua), not by these rules.
#   - The Nginx Lua init_worker.lua parses fast.log every 30 s and feeds
#     matching src_ip values into the threat_intel Redis dict with a score
#     increment of +20 per alert.
###################################################

#--------------------------------------------------------------------------
# CVE-2023-28121: WooCommerce Payments Unauthorized Admin Access
# OWASP WSTG-AUTHZ: Broken Access Control / Privilege Escalation
# Plugin: woocommerce-payments ≤ 5.6.1
# Attack: Inject X-WCPAY-PLATFORM-CHECKOUT-USER header to impersonate any user,
#         then create/modify admin accounts via the WordPress REST API.
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2023-28121 WooCommerce Payments Unauthorized Admin Access Attempt"; flow:established,to_server; content:"X-WCPAY-PLATFORM-CHECKOUT-USER"; http_header; content:"wp/v2/users"; http_uri; classtype:web-application-attack; sid:1000001; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2023-28121 WooCommerce Admin User Creation"; flow:established,to_server; content:"POST"; http_method; content:"rest_route"; http_client_body; content:"wp/v2/users"; http_client_body; classtype:web-application-attack; sid:1000002; rev:1;)

#--------------------------------------------------------------------------
# CVE-2023-2986: Abandoned Cart Lite Hardcoded Encryption Key
# OWASP WSTG-AUTHZ: Authentication bypass via cryptographic weakness
# Plugin: abandoned-cart-lite
# Attack: The plugin uses a hardcoded AES key ("qJB0rGtIn5UB1xG03efyCp") to
#         generate checkout tokens.  An adversary can forge tokens for any user
#         and authenticate as that user without knowing their password.
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2023-2986 Abandoned Cart Lite Exploit Attempt"; flow:established,to_server; content:"wcal_action=checkout_link"; http_uri; content:"validate="; http_uri; classtype:web-application-attack; sid:1000003; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2023-2986 Abandoned Cart Encryption Key Usage"; flow:established,to_server; content:"qJB0rGtIn5UB1xG03efyCp"; http_client_body; classtype:web-application-attack; sid:1000004; rev:1;)

#--------------------------------------------------------------------------
# CVE-2025-4403: User-Controlled File Upload Type
# OWASP WSTG-INPV-10: Unrestricted File Upload
# Plugin: drag-and-drop-multiple-file-upload
# Attack: The supported_type POST parameter is not sanitised, allowing an
#         adversary to override the server-side MIME-type whitelist and upload
#         executable PHP files that can be triggered via a direct URL.
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2025-4403 DnD File Upload Exploit"; flow:established,to_server; content:"POST"; http_method; content:"dnd-wc-upload-file"; http_client_body; content:"supported_type"; http_client_body; pcre:"/supported_type[^&]*\./i"; classtype:web-application-attack; sid:1000005; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2025-4403 Suspicious File Extension Upload"; flow:established,to_server; content:"dnd_codedropz_upload_wc"; http_uri; content:".php"; http_client_body; classtype:web-application-attack; sid:1000006; rev:1;)

#--------------------------------------------------------------------------
# CVE-2025-2266: Unauthenticated WordPress Options Update
# OWASP WSTG-AUTHZ: Missing authentication for privileged operation
# Plugin: cwmp
# Attack: The cwmpUpdateOptions action is accessible without authentication.
#         An adversary sets users_can_register=1 and default_role=administrator
#         to self-register an admin account and take over the site.
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2025-2266 WordPress Options Update Exploit"; flow:established,to_server; content:"POST"; http_method; content:"cwmpUpdateOptions"; http_client_body; content:"users_can_register=1"; http_client_body; classtype:web-application-attack; sid:1000007; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2025-2266 Admin Role Assignment"; flow:established,to_server; content:"cwmpUpdateOptions"; http_uri; content:"default_role=administrator"; http_client_body; classtype:web-application-attack; sid:1000008; rev:1;)

#--------------------------------------------------------------------------
# CVE-2025-47577 & CVE-2024-8425: Unauthenticated File Upload with RCE
# OWASP WSTG-INPV-10: Unrestricted File Upload → Remote Code Execution
# Plugin: gift-voucher (MWB Gift Cards for WooCommerce)
# Attack: The mwb_wgm_preview_mail AJAX action accepts file uploads without
#         authentication or extension validation.  A PHP web-shell uploaded
#         via this endpoint can be executed by browsing to its URL.
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2025-47577 Gift Voucher File Upload RCE"; flow:established,to_server; content:"POST"; http_method; content:"mwb_wgm_preview_mail"; http_uri; content:"multipart/form-data"; http_header; pcre:"/filename[^\\x3b]*\.php/i"; classtype:web-application-attack; sid:1000009; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2024-8425 Malicious PHP Upload"; flow:established,to_server; content:"mwb_wgm_preview_mail"; http_uri; content:"tempId"; http_client_body; content:"<?php"; http_client_body; classtype:web-application-attack; sid:1000010; rev:1;)

#--------------------------------------------------------------------------
# CVE-2024-2387: SQL Injection via URL Parameter
# OWASP WSTG-INPV-05: SQL Injection
# Plugin: advanced-form-integration
# Attack: The integration_id GET parameter in the advanced-form-integration-log
#         admin page is passed unsanitised to a SQL query.  Classic blind,
#         time-based, and UNION-based injection techniques all apply.
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2024-2387 AFI SQL Injection Attempt"; flow:established,to_server; content:"advanced-form-integration-log"; http_uri; content:"integration_id"; http_uri; pcre:"/integration_id[^&]*'/i"; classtype:web-application-attack; sid:1000011; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2024-2387 Time-based SQL Injection"; flow:established,to_server; content:"integration_id"; http_uri; content:"SLEEP"; http_uri; nocase; classtype:web-application-attack; sid:1000012; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2024-2387 Union-based SQL Injection"; flow:established,to_server; content:"integration_id"; http_uri; content:"UNION"; http_uri; nocase; content:"SELECT"; http_uri; nocase; classtype:web-application-attack; sid:1000013; rev:1;)

#--------------------------------------------------------------------------
# CVE-2025-10142 & CVE-2024-50508: File Path Traversal / Arbitrary File Read
# OWASP WSTG-INPV-01: Path Traversal
# Plugins: pagseguro-connect-woocommerce (CVE-2025-10142),
#          wp-file-upload (CVE-2024-50508)
# Attack: The file[path] parameter is not normalised before being used in a
#         file-system operation.  An adversary can read /etc/passwd, wp-config.php,
#         or any other file readable by the web server process.
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2025-10142 Unauthorized File Upload"; flow:established,to_server; content:"pc_added_uploaded_image"; http_uri; content:"file[path]"; http_uri; pcre:"/file\[path\][^&]*\//i"; classtype:web-application-attack; sid:1000014; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2024-50508 Sensitive File Access"; flow:established,to_server; content:"file[path]=/etc/passwd"; http_uri; classtype:web-application-attack; sid:1000015; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CVE-2024-50508 System File Download"; flow:established,to_server; content:"file[path]"; http_uri; pcre:"/file\[path\]=[^&]*\/etc\//i"; classtype:web-application-attack; sid:1000016; rev:1;)

#--------------------------------------------------------------------------
# General WordPress Attack Patterns
# OWASP WSTG-ATHN-04 (brute force), WSTG-IDNT-04 (user enumeration),
# WSTG-CONF-05 (sensitive file exposure), WSTG-INFO-02 (fingerprinting)
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"WordPress Admin Brute Force Attempt"; flow:established,to_server; content:"POST"; http_method; content:"wp-login.php"; http_uri; content:"log="; http_client_body; content:"pwd="; http_client_body; threshold:type limit, track by_src, count 5, seconds 60; classtype:web-application-attack; sid:1000017; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"WordPress User Enumeration"; flow:established,to_server; content:"wp-json/wp/v2/users"; http_uri; classtype:web-application-attack; sid:1000018; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"WordPress Config File Access Attempt"; flow:established,to_server; content:"wp-config.php"; http_uri; classtype:web-application-attack; sid:1000019; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"WordPress Backup File Access"; flow:established,to_server; content:".sql"; http_uri; content:"backup"; http_uri; nocase; classtype:web-application-attack; sid:1000020; rev:1;)

#--------------------------------------------------------------------------
# Plugin-Specific Detection (activity monitoring, not necessarily attack)
# OWASP WSTG-INFO-02: Fingerprinting Web Application Frameworks
# These rules fire on any access to known-vulnerable plugin directories,
# even for benign requests (e.g. fetching the plugin's readme.txt).
# classtype:web-application-activity (lower severity than attack rules).
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"WooCommerce Payments Plugin Access"; flow:established,to_server; content:"woocommerce-payments"; http_uri; classtype:web-application-activity; sid:1000021; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Abandoned Cart Lite Plugin Access"; flow:established,to_server; content:"abandoned-cart-lite"; http_uri; classtype:web-application-activity; sid:1000022; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Drag Drop File Upload Plugin Access"; flow:established,to_server; content:"drag-and-drop-multiple-file-upload"; http_uri; classtype:web-application-activity; sid:1000023; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"CWMP Plugin Access"; flow:established,to_server; content:"/wp-content/plugins/cwmp/"; http_uri; classtype:web-application-activity; sid:1000024; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Gift Voucher Plugin Access"; flow:established,to_server; content:"gift-voucher"; http_uri; classtype:web-application-activity; sid:1000025; rev:1;)

#--------------------------------------------------------------------------
# SQL Injection Detection – Generic Patterns
# OWASP WSTG-INPV-05: Testing for SQL Injection
# These rules complement the CVE-specific rules above by catching novel
# injection attempts that do not match known plugin patterns.
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SQL Injection - Union Select"; flow:established,to_server; pcre:"/union[^a-zA-Z]+select/i"; classtype:web-application-attack; sid:1000026; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SQL Injection - Information Schema"; flow:established,to_server; content:"information_schema"; http_uri; nocase; classtype:web-application-attack; sid:1000027; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SQL Injection - MySQL Functions"; flow:established,to_server; pcre:"/(concat|substring|database|version|user)\s*\(/i"; classtype:web-application-attack; sid:1000028; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"SQL Injection - Time Delay"; flow:established,to_server; pcre:"/(sleep|waitfor|benchmark)\s*\(/i"; classtype:web-application-attack; sid:1000029; rev:1;)

#--------------------------------------------------------------------------
# XSS Detection – Generic Patterns
# OWASP WSTG-INPV-02: Testing for Reflected / Stored Cross Site Scripting
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"XSS Script Tag"; flow:established,to_server; content:"<script"; http_uri; nocase; classtype:web-application-attack; sid:1000030; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"XSS JavaScript Event"; flow:established,to_server; pcre:"/on(load|error|click|mouse|focus|blur|change|submit)\s*=/i"; classtype:web-application-attack; sid:1000031; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"XSS JavaScript Protocol"; flow:established,to_server; content:"javascript:"; http_uri; nocase; classtype:web-application-attack; sid:1000032; rev:1;)

#--------------------------------------------------------------------------
# Command Injection Detection – Generic Patterns
# OWASP WSTG-INPV-12: Testing for Command Injection
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Command Injection - System Commands"; flow:established,to_server; pcre:"/(\x3b|&&|\|\|)\s*(cat|ls|ps|id|whoami|uname)/i"; classtype:web-application-attack; sid:1000033; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Command Injection - Pipe Commands"; flow:established,to_server; pcre:"/\|\s*(nc|netcat|curl|wget|bash|sh)/i"; classtype:web-application-attack; sid:1000034; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Command Injection - Backticks"; flow:established,to_server; content:"`"; http_uri; classtype:web-application-attack; sid:1000035; rev:1;)

#--------------------------------------------------------------------------
# Directory Traversal Detection – Generic Patterns
# OWASP WSTG-INPV-01: Testing for Path Traversal
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Directory Traversal - Dot Dot Slash"; flow:established,to_server; content:"../"; http_uri; classtype:web-application-attack; sid:1000036; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Directory Traversal - URL Encoded"; flow:established,to_server; pcre:"/%2e%2e[%2f%5c]/i"; classtype:web-application-attack; sid:1000037; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Directory Traversal - Double Encoded"; flow:established,to_server; pcre:"/%252e%252e/i"; classtype:web-application-attack; sid:1000038; rev:1;)

#--------------------------------------------------------------------------
# File Inclusion Detection – PHP Stream Wrapper Abuse
# OWASP WSTG-INPV-11: Testing for Local File Inclusion
#          WSTG-INPV-07: Testing for XML Injection (data:// URI)
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"PHP Wrapper Usage"; flow:established,to_server; pcre:"/php:\/\/(filter|input|output|fd|memory|temp|stdin)/i"; classtype:web-application-attack; sid:1000039; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Data URI Scheme"; flow:established,to_server; content:"data://"; http_uri; nocase; classtype:web-application-attack; sid:1000040; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"File URI Scheme"; flow:established,to_server; content:"file://"; http_uri; nocase; classtype:web-application-attack; sid:1000041; rev:1;)

#--------------------------------------------------------------------------
# Malicious User Agents – Security Tool Fingerprinting
# OWASP WSTG-INFO-02: Fingerprint Web Application Framework
# These rules identify well-known attack tools by their User-Agent strings.
# src_ip of matching alerts is fed into the Nginx threat_intel dict with a
# +20 score increment, potentially crossing the honeypot routing threshold.
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Malicious User Agent - SQLMap"; flow:established,to_server; content:"sqlmap"; http_user_agent; nocase; classtype:web-application-attack; sid:1000042; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Malicious User Agent - Nikto"; flow:established,to_server; content:"nikto"; http_user_agent; nocase; classtype:web-application-attack; sid:1000043; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Malicious User Agent - Nmap"; flow:established,to_server; content:"nmap"; http_user_agent; nocase; classtype:web-application-attack; sid:1000044; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Malicious User Agent - WPScan"; flow:established,to_server; content:"wpscan"; http_user_agent; nocase; classtype:web-application-attack; sid:1000045; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Malicious User Agent - Gobuster"; flow:established,to_server; content:"gobuster"; http_user_agent; nocase; classtype:web-application-attack; sid:1000046; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Malicious User Agent - Dirb"; flow:established,to_server; content:"dirb"; http_user_agent; nocase; classtype:web-application-attack; sid:1000047; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Malicious User Agent - Burp Suite"; flow:established,to_server; content:"burpsuite"; http_user_agent; nocase; classtype:web-application-attack; sid:1000048; rev:1;)

#--------------------------------------------------------------------------
# Scanning and Reconnaissance – Version Fingerprinting Probes
# OWASP WSTG-INFO-02: Fingerprint Web Application Framework
# Accessing wp-includes/version.php directly reveals the exact WordPress
# version in plain text, enabling targeted CVE selection by the adversary.
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"WordPress Version Detection"; flow:established,to_server; content:"wp-includes/version.php"; http_uri; classtype:web-application-attack; sid:1000049; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"WordPress Theme Detection"; flow:established,to_server; content:"wp-content/themes/"; http_uri; content:"style.css"; http_uri; classtype:web-application-attack; sid:1000050; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"WordPress Plugin Enumeration"; flow:established,to_server; content:"wp-content/plugins/"; http_uri; content:"readme.txt"; http_uri; classtype:web-application-attack; sid:1000051; rev:1;)

# rev:2 -- two fixes for confirmed false positives on authenticated admin use.
# (1) The old pcre had NO buffer modifier, so it matched the whole request,
# not the URI. Every page a logged-in admin loads carries a
# `Referer: https://host/wp-admin/...` header, so the rule fired on ordinary
# navigation (and even on static-asset/admin-ajax requests whose own URL was
# blank -- see the empty-URL alerts in the dashboard). The `/Ui` modifier now
# scopes the match to the normalised request URI alone, anchored with `^\/`.
# (2) `admin` on its own matched any path containing that substring (product
# slugs, /my-account?admin=...) and `wp-admin` matched every authenticated
# click. A genuine logged-in administrator always carries the
# `wordpress_logged_in_<hash>` session cookie, which the reverse proxy forwards
# to the backend, so excluding it drops all real admin navigation. What remains
# is discovery of panels that DON'T exist on a WordPress site (administrator,
# phpmyadmin, cpanel, adminer, a bare /admin) plus the unauthenticated bare
# /wp-admin probe -- which is what "discovery" actually means.
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Admin Panel Discovery"; flow:established,to_server; pcre:"/^\/(administrator|phpmyadmin|pma|cpanel|adminer|admin\/?(\?|$)|wp-admin\/?(\?|$))/Ui"; content:!"wordpress_logged_in"; http_cookie; classtype:web-application-attack; sid:1000052; rev:2;)

#--------------------------------------------------------------------------
# Suspicious File Uploads
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Suspicious PHP File Upload"; flow:established,to_server; content:"multipart/form-data"; http_header; content:".php"; http_client_body; classtype:web-application-attack; sid:1000053; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Executable File Upload Attempt"; flow:established,to_server; content:"multipart/form-data"; http_header; pcre:"/filename[^\\x3b]*\.(exe|bat|cmd|sh|jar)/i"; classtype:web-application-attack; sid:1000054; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Script File Upload Attempt"; flow:established,to_server; content:"multipart/form-data"; http_header; pcre:"/filename[^\\x3b]*\.(jsp|asp|aspx|pl|py|rb)/i"; classtype:web-application-attack; sid:1000055; rev:1;)

#--------------------------------------------------------------------------
# Rate Limiting and DoS Detection
#--------------------------------------------------------------------------
# rev:2 -- was unconditional (every HTTP request counted, including
# static assets), which false-positived on ordinary page loads: confirmed
# live a single production_eshop homepage view references 79 static
# assets (55 of them product images) -- easily enough on its own, spread
# across a normal multi-page visit, to cross 50 requests/60s from nothing
# but a real customer browsing. nginx itself already treats these same
# extensions as "no attack surface" (see nginx.conf's static-asset
# location block and router.lua's Stage 1 fast-path, both bypassing ALL
# risk scoring for them) -- this rule just didn't share that judgment,
# so it's now excluded here too, using the identical extension list.
# What's left genuinely is a rate check on dynamic/page requests, which is
# what "High Rate HTTP Requests" as a DoS signal is actually meant to
# catch.
# rev:3 -- also excludes the reverse_proxy's own internal backend probes.
# health_check.lua (HEAD /robots.txt, every 15s, plus a burst of prewarm
# connections) and wp_install_state.lua (GET /wp-admin/install.php) probe
# every pool on a timer; Suricata sees them all leave the proxy's single IP,
# so from nothing but healthy infrastructure they used to cross 50 req/60s by
# src and fire this DoS alert. They carry a dedicated User-Agent
# (health_check.lua's HEALTHCHECK_USER_AGENT) that real client traffic never
# has, so matching it here drops only the probes -- the checks keep running.
# rev:4 -- also excludes the WordPress AJAX/cron endpoints. Because Suricata
# sees proxy->backend traffic (network_mode:host), every client shares the
# reverse_proxy's single source IP, so `track by_src` sums ALL visitors
# together. admin-ajax.php (the Heartbeat API polls it every 15-60s per open
# admin/editor tab, plus cart/autosave AJAX) and wp-cron.php are the two
# endpoints that legitimately fire at a steady background rate, so aggregated
# across every session they crossed 50 req/60s and false-fired this DoS alert
# with no attacker present (confirmed live: an admin-ajax.php "High Rate HTTP
# Requests" alert while merely logged in). Excluding them leaves the rule
# watching genuine high-rate page/endpoint flooding, which is the DoS signal.
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"High Rate HTTP Requests"; flow:established,to_server; pcre:!"/\.(css|js|jpe?g|png|gif|svg|webp|webm|mp4|mp3|pdf|woff2?|ttf|eot|otf|ico)(\?.*)?$/Ui"; content:!"admin-ajax.php"; http_uri; content:!"wp-cron.php"; http_uri; content:!"honeypot-internal-healthprobe"; http_user_agent; detection_filter:track by_src, count 50, seconds 60; classtype:attempted-dos; sid:1000056; rev:4;)

# rev:2 -- now requires POST, so merely VIEWING the login page never counts.
# The old rule counted any request whose URI held "wp-login.php", GET included.
# Since all traffic shares the reverse_proxy source IP (network_mode:host),
# `track by_src` aggregates everyone, so ordinary visitors each opening the
# login page once summed past 10/60s and false-fired "brute force" with no
# password attempt made at all. A brute-force attack is repeated credential
# SUBMISSION, i.e. POST /wp-login.php -- counting only those (and never the
# internal health probe) keeps the attack signal while page views stop
# triggering it. (sid:1000017 remains the stricter log=/pwd= body check.)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"WordPress Login Brute Force"; flow:established,to_server; content:"POST"; http_method; content:"wp-login.php"; http_uri; content:!"honeypot-internal-healthprobe"; http_user_agent; detection_filter:track by_src, count 10, seconds 60; classtype:web-application-attack; sid:1000057; rev:2;)

#--------------------------------------------------------------------------
# Honeypot Specific Rules
#--------------------------------------------------------------------------
# rev:2 -- was `content:"wp-content/plugins/"` alone, which matches every
# CSS/JS/image/font a browser loads from ANY plugin's assets directory on
# an ordinary page view (confirmed live: a single WooCommerce/Elementor
# page load easily hits 10+ such URIs), not just vulnerability probes --
# false-positived on a real customer's normal browsing of production_eshop,
# poisoning threat_ips for reverse_proxy's own IP (172.21.0.9, per
# Suricata's network_mode:host visibility -- see suricata_rules.lua's
# module docstring on that attribution caveat) well past the >50
# honeypot-diversion threshold from nothing but ordinary traffic. Static
# assets (css/js/png/svg/woff/...) never end in .php -- direct .php access
# under a plugin directory is what actually indicates someone trying to
# reach/exploit plugin code, not just load its stylesheet, so requiring
# both substrings keeps the rule's original intent (repeated hits across
# multiple plugin endpoints in a short window) without matching normal
# asset loading.
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Honeypot Trigger - Multiple Vulnerability Attempts"; flow:established,to_server; content:"wp-content/plugins/"; http_uri; content:".php"; http_uri; detection_filter:track by_src, count 3, seconds 300; classtype:web-application-attack; priority:1; sid:1000058; rev:2;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Honeypot Trigger - Automated Tool Detection"; flow:established,to_server; pcre:"/(sqlmap|nikto|nmap|wpscan|gobuster|dirb|burpsuite|nuclei|whatweb)/i"; classtype:web-application-attack; priority:1; sid:1000059; rev:1;)

# rev:2 -- excludes the reverse_proxy's own install-state probe. Every
# HEALTH_CHECK_INTERVAL, wp_install_state.lua GETs /wp-admin/install.php on
# each pool to learn whether setup is done (see router.lua's install.php
# routing). That URI matches the wp-admin branch of the pcre below, so across
# all pools the proxy's single IP crossed 5 hits/60s and false-fired this
# "rapid scanning" alert with no adversary present. The probe carries a
# dedicated User-Agent (health_check.lua's HEALTHCHECK_USER_AGENT) real
# clients never send, so excluding it drops only the probe, not genuine
# wp-admin/wp-login/xmlrpc scanning by an actual visitor.
# rev:3 -- the UA exclusion alone did not stop the false positives the health
# probe comment below describes, because the old pcre had no buffer modifier:
# it matched the whole request, so a logged-in admin's `Referer:
# .../wp-admin/...` header on EVERY subsequent request (and on every static
# asset and admin-ajax call the admin UI loads) counted toward the 5/60s
# threshold, even when the request's own URI never touched wp-admin. Three
# fixes: (1) `/Ui` scopes the match to the request URI only, so Referer/cookie
# text no longer counts; (2) a negative asset pcre drops the admin UI's own
# css/js/font loads; (3) excluding the `wordpress_logged_in` session cookie
# drops authenticated navigation outright -- an administrator working in
# wp-admin is not "scanning" it. The health-probe UA exclusion is retained.
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Honeypot Trigger - Rapid Vulnerability Scanning"; flow:established,to_server; pcre:"/\/(wp-admin|wp-login|wp-config|xmlrpc\.php)/Ui"; pcre:!"/\.(css|js|jpe?g|png|gif|svg|webp|woff2?|ttf|eot|otf|ico|map)(\?.*)?$/Ui"; content:!"wordpress_logged_in"; http_cookie; content:!"honeypot-internal-healthprobe"; http_user_agent; detection_filter:track by_src, count 5, seconds 60; classtype:web-application-attack; priority:1; sid:1000060; rev:3;)

#--------------------------------------------------------------------------
# Session Management Integration Rules
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Session Anomaly - IP Change"; flow:established,to_server; content:"PHPSESSID="; http_header; classtype:policy-violation; sid:1000061; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Session Anomaly - User Agent Change"; flow:established,to_server; content:"PHPSESSID="; http_header; classtype:policy-violation; sid:1000062; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Suspicious Session Cookie Manipulation"; flow:established,to_server; content:"PHPSESSID="; http_header; pcre:"/PHPSESSID=[^\x3b]{0,10}[^a-zA-Z0-9]/i"; classtype:web-application-attack; sid:1000063; rev:1;)

#--------------------------------------------------------------------------
# Zero-Day and Generic Attack Patterns  
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Generic Code Injection Attempt"; flow:established,to_server; pcre:"/(eval|exec|system|passthru|shell_exec|assert|create_function)\s*\(/i"; classtype:web-application-attack; sid:1000064; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Generic Deserialization Attack"; flow:established,to_server; pcre:"/(a:|O:|s:|i:|b:|d:|r:|C:|N:)\d+:/i"; classtype:web-application-attack; sid:1000065; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Generic Template Injection"; flow:established,to_server; pcre:"/\{\{|\}\}|\{%|%\}/i"; classtype:web-application-attack; sid:1000066; rev:1;)

#--------------------------------------------------------------------------
# API Abuse Detection
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"WordPress REST API Abuse"; flow:established,to_server; content:"wp-json"; http_uri; detection_filter:track by_src, count 20, seconds 60; classtype:web-application-attack; sid:1000067; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"XMLRPC Amplification Attack"; flow:established,to_server; content:"xmlrpc.php"; http_uri; content:"system.multicall"; http_client_body; classtype:web-application-attack; sid:1000068; rev:1;)

#--------------------------------------------------------------------------
# Custom Malware and Backdoor Detection
#--------------------------------------------------------------------------
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"PHP Webshell Detection"; flow:established,to_server; pcre:"/\$_(GET|POST|REQUEST)\[.*\]\s*\(\s*\$_(GET|POST|REQUEST)/i"; classtype:web-application-attack; sid:1000069; rev:1;)

alert http any any -> $HOME_NET $HTTP_PORTS (msg:"Encoded PHP Payload"; flow:established,to_server; pcre:"/(base64_decode|gzinflate|str_rot13|gzuncompress)\s*\(/i"; classtype:web-application-attack; sid:1000070; rev:1;)